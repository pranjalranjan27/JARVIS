# ═══════════════════════════════════════════
#  Jarvis — .gitignore
# ═══════════════════════════════════════════

# ── Java build output ──
target/
out/
*.class
*.jar
!lib/*.jar

# ── Runtime database (auto-created on first run) ──
jarvis.db

# ── IDE ──
.vscode/
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
nbproject/

# ── OS files ──
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Logs ──
*.log

# ── Environment / secrets ──
.env
.env.local
.env.*.local

# ── Temp / cache ──
temp/
cache/
%TEMP%/
*.tmp
*.swp
*~

# ── Node (if added later) ──
node_modules/
package-lock.json
